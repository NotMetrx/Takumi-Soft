{
  "name": "symbiolab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:science": "node scripts/build-science.mjs",
    "prebuild": "npm run build:science",
    "test:rust": "cargo test --manifest-path crates/chemistry/Cargo.toml",
    "test:science": "npm run build:science && npm run test:rust && vitest run tests/science",
    "bench:science": "vitest bench --run tests/science/numeric_engine.bench.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.170.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.65.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.170.0"
  }
}
